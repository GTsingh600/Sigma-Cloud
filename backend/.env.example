# ─── SigmaCloud AI backend configuration ─────────────────────────────────────
# Copy to .env for local development. On Render, set these in the dashboard
# under Environment instead - this file is never read there.

# development | production
# Setting production makes a missing JWT_SECRET_KEY a hard startup failure.
ENVIRONMENT=development

# ─── Database ────────────────────────────────────────────────────────────────
# Local default is SQLite. In production paste the connection string from your
# provider. A `postgres://` prefix is rewritten to `postgresql://` for you.
DATABASE_URL=sqlite:///./sigmacloud.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_HOURS=24

# From Google Cloud Console > Credentials > OAuth 2.0 Client ID.
# Must be the same value the frontend uses for NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Exact origins allowed to call this API. JSON array or comma-separated.
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Optional regex for preview deployments. Keep it scoped to YOUR project -
# a bare `https://.*\.vercel\.app` lets any site on Vercel call this API.
# ALLOWED_ORIGIN_REGEX=https://sigmacloud-[a-z0-9-]+\.vercel\.app

# ─── Storage ─────────────────────────────────────────────────────────────────
# Point these at a mounted persistent disk if you have one. On an ephemeral
# filesystem these still work, but files vanish when the service restarts.
BASE_STORAGE_PATH=./backend/storage
MODEL_STORAGE_PATH=./backend/storage/models
DATASET_STORAGE_PATH=./backend/storage/datasets

MAX_UPLOAD_BYTES=26214400

# ─── Runtime ─────────────────────────────────────────────────────────────────
# File logging is off by default; ephemeral hosts capture stdout already.
LOG_TO_FILE=false

# Jobs still 'running' after this long are assumed killed by a restart.
STALE_JOB_TIMEOUT_MINUTES=30
